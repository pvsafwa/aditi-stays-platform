# Copy to .env and fill in real values before running `docker compose up`.
# docker-compose reads .env automatically; it must never be committed (see .gitignore).

POSTGRES_PASSWORD=

# Must match keycloak/realm-export.json's internal-service client secret exactly
# (that file is dev-only and self-bootstraps Keycloak -- change both together
# if you ever deploy this beyond local dev).
KEYCLOAK_CLIENT_SECRET=internal-service-secret-change-me

# WebSocket admin-connection secret (unrelated to admin HTTP auth, which is
# JWT-based via Keycloak now) -- still a shared static secret.
ADMIN_CHAT_TOKEN=
USER_CHAT_TOKEN_SECRET=

# Optional, defaults to http://localhost:3000
CORS_ALLOWED_ORIGINS=
