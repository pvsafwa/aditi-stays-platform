# Copy to .env.local and fill in real values. Never commit .env.local.

# Gateway URL (see root README) -- everything else stays as before.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8090
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8090

# NextAuth core config. Generate a secret with `openssl rand -base64 32`.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Keycloak OIDC client used for the admin login screen -- matches the
# "admin-dashboard" client in keycloak/realm-export.json at the repo root.
KEYCLOAK_ISSUER=http://localhost:8180/realms/aditi-stays
KEYCLOAK_CLIENT_ID=admin-dashboard
KEYCLOAK_CLIENT_SECRET=admin-dashboard-secret-change-me

# Must match the ADMIN_CHAT_TOKEN set in the root .env (chat-service's admin
# WebSocket connection still authenticates with this static secret -- see
# ChatSecurity.verifyAdminWsToken). Server-only: never exposed to the client
# bundle directly, only served from /api/admin/chat-token to a signed-in
# admin session.
ADMIN_CHAT_TOKEN=
